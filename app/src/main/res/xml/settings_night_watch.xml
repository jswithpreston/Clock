<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        How-it-works explanation shown as a non-clickable info block.
        Uses a plain Preference with a long summary — same pattern as the
        permission_message preference in the main Settings screen.
    -->
    <PreferenceCategory
        android:title="@string/night_watch_explanation_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="key_night_watch_explanation"
            android:layout="@layout/settings_preference_layout"
            android:summary="@string/night_watch_explanation_text"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:selectable="false" />

        <Preference
            android:key="key_night_watch_charging_reminder"
            android:layout="@layout/settings_preference_layout"
            android:summary="@string/night_watch_charging_reminder"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:selectable="false" />

    </PreferenceCategory>

    <!-- A/B testing toggles so user can isolate which layer keeps XOS alive -->
    <PreferenceCategory
        android:title="@string/miscellaneous_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="key_night_watch_use_microphone"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/night_watch_use_microphone_title"
            android:summary="@string/night_watch_use_microphone_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_night_watch_hold_wake_lock"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/night_watch_hold_wake_lock_title"
            android:summary="@string/night_watch_hold_wake_lock_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!--
        Permissions section — walks the user through:
          1. RECORD_AUDIO  (runtime)
          2. Battery optimization exemption  (Settings deeplink)
          3. OEM autostart / background settings  (best-effort deeplinks)
    -->
    <PreferenceCategory
        android:title="@string/permissions_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="key_night_watch_request_mic_permission"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/notifications_permission_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_night_watch_battery_exemption"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/ignore_battery_optimizations_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_night_watch_autostart"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/night_watch_autostart_title"
            android:summary="@string/night_watch_autostart_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- Debug section — visible only in debug builds (hidden at runtime in release) -->
    <PreferenceCategory
        android:key="key_night_watch_debug_category"
        android:title="@string/debug_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="key_night_watch_debug_cancel_alarm"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/night_watch_debug_cancel_alarm_title"
            android:summary="@string/night_watch_debug_cancel_alarm_summary"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
